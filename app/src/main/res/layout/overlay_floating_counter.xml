<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llOverlayContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_floating_counter"
    android:paddingStart="10dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:gravity="center_vertical"
    android:elevation="12dp">

    <!-- Cute Dumpling/Bao Mascot Avatar on Top/Left of Counter -->
    <ImageView
        android:id="@+id/ivMascot"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_avatar_mascot"
        android:contentDescription="StopScroll Mascot" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCounterStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Watching Reels"
            android:textColor="#666666"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCounterText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 / 30"
            android:textColor="@color/pink_primary"
            android:textStyle="bold"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>
